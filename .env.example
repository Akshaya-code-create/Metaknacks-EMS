# Backend runtime
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# Supabase PostgreSQL transaction pooler (port 6543).
# Copy the URI from Supabase Dashboard > Connect > Transaction pooler.
# Replace placeholders with your project ref, pooler host, and database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<database-password>@<region>.pooler.supabase.com:6543/postgres?pgbouncer=true

# Server-only Supabase Storage credentials
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
SUPABASE_STORAGE_BUCKET=voter-documents

# Used only when intentionally running create-admin.js
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password
ALLOW_ADMIN_SEED=false
